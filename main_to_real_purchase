from api.auth import get_access_token
from api.order import (
    buy_stock,
    sell_stock,
    get_order_status,
    is_order_filled
)

# =====================================
# 안전 설정
# =====================================

# 실제 주문 활성화
ENABLE_REAL_ORDER = True

# 테스트 종목
SYMBOL = "191410"  # 육일씨엔에스

# 테스트 수량
QUANTITY = 1

# 시장가 주문
PRICE = None

# 주문 유형
ORDER_TYPE = "BUY"

# 계좌 순번
ACCOUNT_SEQ = 1

# =====================================
# 메인 시작
# =====================================

token = get_access_token()

if not token:
    print("토큰 발급 실패")
    exit()

print("토큰 발급 성공!")

print("\n===== 주문 예정 =====")
print("종목:", SYMBOL)
print("주문:", ORDER_TYPE)
print("수량:", QUANTITY)

if PRICE is None:
    print("주문방식: 시장가")
else:
    print("주문방식: 지정가")
    print("가격:", PRICE)

print("====================")

# 사용자 최종 확인
confirm = input("\n주문을 진행할까요? (y/n): ")

if confirm.lower() != "y":
    print("주문 취소")
    exit()


# 안전장치
if not ENABLE_REAL_ORDER:

    print("\n[안전모드]")
    print("실제 주문은 실행되지 않습니다.")
    print("실제 주문을 원하면")
    print("ENABLE_REAL_ORDER = True 로 변경하세요.")

else:
    MAX_ORDER_QTY = 1

    if QUANTITY > MAX_ORDER_QTY:
        raise ValueError("허용된 최대 주문 수량을 초과했습니다.")

    if ORDER_TYPE == "BUY":

        result = buy_stock(
            access_token=token,
            account_seq=ACCOUNT_SEQ,
            symbol=SYMBOL,
            quantity=QUANTITY,
            price=PRICE
        )

    elif ORDER_TYPE == "SELL":

        result = sell_stock(
            access_token=token,
            account_seq=ACCOUNT_SEQ,
            symbol=SYMBOL,
            quantity=QUANTITY,
            price=PRICE
        )

    else:
        print("잘못된 주문 타입")
        exit()

    print("\n주문 결과")
    print(result)
    # =====================================
    # 주문 체결 여부 자동 확인
    # =====================================

    if result and "result" in result:

        order_id = result["result"]["orderId"]

        print("\n주문번호:", order_id)

        import time

        print("\n3초 후 주문 상태를 조회합니다...")
        time.sleep(3)

        order_status = get_order_status(
            access_token=token,
            account_seq=ACCOUNT_SEQ,
            order_id=order_id
        )

    if is_order_filled(order_status):

        execution = order_status["result"]["execution"]

        print("\n✅ 주문 체결 완료")

        print(
            f"체결수량: "
            f"{execution['filledQuantity']}"
        )

        print(
            f"평균체결가: "
            f"{execution['averageFilledPrice']}원"
        )

        print(
            f"체결시간: "
            f"{execution['filledAt']}"
        )

    else:

        print("\n⏳ 아직 체결되지 않았습니다.")