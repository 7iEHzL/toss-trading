import math

from api.auth import get_access_token
from api.order import (
    buy_stock,
    sell_stock,
    get_order_status,
    is_order_filled
)
from config.settings import ENABLE_REAL_ORDER

# =====================================
# 안전 설정
# =====================================

# 테스트 종목
SYMBOL = "191410"  # 육일씨엔에스

# 테스트 수량
QUANTITY = 1

# 시장가 주문
PRICE = None

# 주문 유형
ORDER_TYPE = "BUY"

# 계좌 순번
ACCOUNT_SEQ = 1
MAX_ORDER_QTY = 1

# =====================================
# 메인 시작
# =====================================


def validate_order_request(order_type, symbol, quantity, price, account_seq):
    if not isinstance(order_type, str) or order_type not in {"BUY", "SELL"}:
        raise ValueError("주문 유형은 BUY 또는 SELL이어야 합니다.")

    if not isinstance(symbol, str) or not symbol.strip():
        raise ValueError("종목 코드는 비어 있지 않은 문자열이어야 합니다.")

    if isinstance(quantity, bool) or not isinstance(quantity, int):
        raise ValueError("주문 수량은 정수여야 합니다.")

    if quantity <= 0 or quantity > MAX_ORDER_QTY:
        raise ValueError(
            f"주문 수량은 1 이상 {MAX_ORDER_QTY} 이하여야 합니다."
        )

    if isinstance(account_seq, bool) or not isinstance(account_seq, int):
        raise ValueError("계좌 순번은 양의 정수여야 합니다.")

    if account_seq <= 0:
        raise ValueError("계좌 순번은 양의 정수여야 합니다.")

    if price is not None:
        if isinstance(price, bool) or not isinstance(price, (int, float)):
            raise ValueError("지정가 가격은 양수여야 합니다.")

        if not math.isfinite(price) or price <= 0:
            raise ValueError("지정가 가격은 양수여야 합니다.")


def main():
    if not ENABLE_REAL_ORDER:
        print("\n[안전모드]")
        print("Live trading이 비활성화되어 있습니다.")
        print("API 호출과 실제 주문을 실행하지 않습니다.")
        return

    validate_order_request(
        order_type=ORDER_TYPE,
        symbol=SYMBOL,
        quantity=QUANTITY,
        price=PRICE,
        account_seq=ACCOUNT_SEQ,
    )

    print("\n===== 주문 예정 =====")
    print("종목:", SYMBOL)
    print("주문:", ORDER_TYPE)
    print("수량:", QUANTITY)

    if PRICE is None:
        print("주문방식: 시장가")
    else:
        print("주문방식: 지정가")
        print("가격:", PRICE)

    print("====================")

    # 사용자 최종 확인
    confirm = input("\n주문을 진행할까요? (y/n): ")

    if confirm.lower() != "y":
        print("주문 취소")
        return

    token = get_access_token()

    if not token:
        print("토큰 발급 실패")
        return

    print("토큰 발급 성공!")

    if ORDER_TYPE == "BUY":

        result = buy_stock(
            access_token=token,
            account_seq=ACCOUNT_SEQ,
            symbol=SYMBOL,
            quantity=QUANTITY,
            price=PRICE,
            live_order_confirmed=True
        )

    elif ORDER_TYPE == "SELL":

        result = sell_stock(
            access_token=token,
            account_seq=ACCOUNT_SEQ,
            symbol=SYMBOL,
            quantity=QUANTITY,
            price=PRICE,
            live_order_confirmed=True
        )

    print("\n주문 결과")
    print(result)
    # =====================================
    # 주문 체결 여부 자동 확인
    # =====================================

    if not isinstance(result, dict):
        print("주문 응답을 확인할 수 없어 상태 조회를 중단합니다.")
        return

    result_data = result.get("result")

    if not isinstance(result_data, dict) or not result_data.get("orderId"):
        print("주문번호가 없어 상태 조회를 중단합니다.")
        return

    order_id = result_data["orderId"]

    print("\n주문번호:", order_id)

    import time

    print("\n3초 후 주문 상태를 조회합니다...")
    time.sleep(3)

    order_status = get_order_status(
        access_token=token,
        account_seq=ACCOUNT_SEQ,
        order_id=order_id
    )

    if not isinstance(order_status, dict):
        print("주문 상태 응답을 확인할 수 없습니다.")
        return

    status_result = order_status.get("result")

    if not isinstance(status_result, dict) or not status_result.get("status"):
        print("주문 상태 값이 없어 확인을 중단합니다.")
        return

    if is_order_filled(order_status):

        execution = status_result.get("execution")

        if not isinstance(execution, dict):
            print("체결 상세 응답을 확인할 수 없습니다.")
            return

        print("\n✅ 주문 체결 완료")

        print(
            f"체결수량: "
            f"{execution.get('filledQuantity', '확인 불가')}"
        )

        print(
            f"평균체결가: "
            f"{execution.get('averageFilledPrice', '확인 불가')}원"
        )

        print(
            f"체결시간: "
            f"{execution.get('filledAt', '확인 불가')}"
        )

    else:

        print("\n⏳ 아직 체결되지 않았습니다.")


if __name__ == "__main__":
    main()
